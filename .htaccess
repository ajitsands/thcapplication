# Directory Index
DirectoryIndex index.php index.html

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
</IfModule>

# THC-FM Persistent Sessions (30 days)
<IfModule mod_php7.c>
    php_value session.gc_maxlifetime 2592000
    php_value session.cookie_lifetime 2592000
</IfModule>
<IfModule mod_php.c>
    php_value session.gc_maxlifetime 2592000
    php_value session.cookie_lifetime 2592000
</IfModule>

# Prevent viewing sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(^#.*#|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist)|~)$">
    Order allow,deny
    Deny from all
</FilesMatch>
